#ifndef WEATHER_STATION_CONFIG_H
#define WEATHER_STATION_CONFIG_H
#include "board_wiring.h"

// ==============================================================================
// CẤU HÌNH THÔNG SỐ TRẠM ĐO IOT (MẪU)
// Sao chép thành weather_config.h và điền thông tin mạng của bạn.
// Tên riêng tránh trùng config.h trong bộ công cụ ESP8266.
// ==============================================================================

// WiFi Credentials
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// MQTT Broker Configuration
#define MQTT_BROKER_HOST    "192.168.1.100"  // Địa chỉ IP máy tính chạy MQTT Broker
#define MQTT_BROKER_PORT    1883
#define MQTT_CLIENT_ID      "esp_weather_station_01"
#define STATION_DEVICE_ID   "station01"  // Same ID as backend/dashboard
#define MQTT_USERNAME       "weather_admin"
#define MQTT_PASSWORD       "weather_secure_pass_2026"

// MQTT Topics
#define TOPIC_WEATHER_DATA      "weather/station01/data"
#define TOPIC_WEATHER_ALERT     "weather/station01/alert"
#define TOPIC_WEATHER_STATUS    "weather/station01/status"

// Chu kỳ đọc và gửi dữ liệu (mili-giây)
#define SAMPLING_INTERVAL_MS    5000  // 5 giây một lần
#define SERIAL_BAUD_RATE        115200
#define I2C_CLOCK_HZ            100000
#define OLED_I2C_ADDRESS        0x3C
#define OLED_I2C_FALLBACK_ADDRESS 0x3D
#define BMP_I2C_ADDRESS         0x76
#define BMP_I2C_FALLBACK_ADDRESS 0x77
#define MQTT_RETRY_INTERVAL_MS  5000
#define MQTT_SOCKET_TIMEOUT_S   1
#define MQTT_BUFFER_SIZE        512
#define SENSOR_FILTER_WINDOW    5

// Định nghĩa chân phần cứng (ESP32)
#ifdef ESP32_BOARD
  #define PIN_I2C_SDA           21
  #define PIN_I2C_SCL           22
  #define PIN_RAIN_ANALOG       34
  #define PIN_BUZZER            19  // Relay IN or transistor input
  #define PIN_STATUS_LED        18
  #define PIN_DHT               14
#else
  // ESP8266 NodeMCU
  #define PIN_I2C_SDA           4   // D2
  #define PIN_I2C_SCL           5   // D1
  #define PIN_RAIN_ANALOG       A0  // A0
  #define PIN_DHT               14  // D5
  #define PIN_BUZZER            ESP8266_RELAY_GPIO  // D0 -> relay IN; buzzer uses COM/NO
  #define PIN_STATUS_LED        13  // D7
#endif

// Verify the module's HIGH/LOW trigger jumper; change to LOW if needed.
#define RELAY_ACTIVE_LEVEL      HIGH
#define RELAY_ON_TIME_MS        3000  // One 3-second activation per alert
#define ALERT_DURATION_MS       10000
#define LED_BLINK_INTERVAL_MS   250

// Calibrate with dry/wet readings on the actual sensor and board.
// ESP8266 ADC returns 0-1023; ESP32 ADC returns 0-4095.
#ifdef ESP32_BOARD
  #define RAIN_ANALOG_THRESHOLD 2500
#else
  #define RAIN_ANALOG_THRESHOLD 600
#endif

// Flip to false only if wet AO readings are higher than dry readings.
#define RAIN_WET_IS_LOW         true

#endif // WEATHER_STATION_CONFIG_H

