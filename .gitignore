# ==============================================================================
# Git Ignore Configuration - IoT Local Weather Monitoring & Forecasting Project
# ==============================================================================

# --- Personal Workspaces (QUAN TRỌNG: Không commit tài liệu nháp cá nhân lên repo chung) ---
personal/**
!personal/
!personal/*/
!personal/README.md
!personal/**/.gitkeep

# --- Environment & Secret Variables ---
.env
.env.local
.env.*.local
*.env
credentials.json
secrets.json
telegram_token.txt
*.pem
*.key

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Type Checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Jupyter Notebooks Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Machine Learning Data & Models (Tránh commit file nặng vào Git) ---
# Bỏ qua dữ liệu thô và đã xử lý lớn, chỉ cho phép commit file mẫu trong data/sample/
ai_engine/data/raw/*
!ai_engine/data/raw/.gitkeep
ai_engine/data/processed/*
!ai_engine/data/processed/.gitkeep

# Model weights nặng (PyTorch, TensorFlow, Pickle, Joblib, ONNX > 20MB)
# Khuyến khích quản lý model weights qua Git LFS / DVC hoặc Google Drive release
*.h5
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
*.onnx
!ai_engine/saved_models/.gitkeep

# --- Embedded & C++ (PlatformIO / Arduino / ESP-IDF) ---
.pio/
.pioenvs/
.piolibdeps/
*.hex
*.bin
*.elf
*.o
*.a
*.d
*.map
compile_commands.json

# --- Node / Modern Web Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.turbo/
.next/
out/

# --- IDEs, Editors & OS System Files ---
# JetBrains (PyCharm, CLion)
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Operating Systems
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary files
*.swp
*.swo
*~
*.bak
*.tmp
